# Pinj0r example configuration

# Target endpoint accepting HTTP POST requests.
export PINJ0R_TARGET_URL="https://example.com/chat"

# Bearer token used for authentication.
# Do not commit real tokens.
export PINJ0R_BEARER_TOKEN="replace-me"

# Optional: directory for output files.
export PINJ0R_RESULTS_DIR="results"

# Optional: directory containing attack prompt files.
# Each .txt file should contain one prompt injection per line.
export PINJ0R_ATTACKS_DIR="attacks"

# Optional: JSON field used for each prompt in the request body.
export PINJ0R_JSON_FIELD="message"

# Optional: raw JSON request body template.
# Use {{prompt}} where Pinj0r should inject each attack prompt.
# When set, this takes precedence over PINJ0R_JSON_FIELD.
# export PINJ0R_REQUEST_TEMPLATE_FILE="request.template.example.json"

# Optional: file containing suspicious response patterns.
export PINJ0R_PATTERNS_FILE="patterns.txt"
